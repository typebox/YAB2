<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.1.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="YamlDotNet" Version="17.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Yab.Kernel\Yab.Kernel.csproj" />
    <ProjectReference Include="..\Yab.Runtime\Yab.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\PortalTemplate.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude the portal source project from the .NET build -->
    <Compile Remove="portal\**" />
    <EmbeddedResource Remove="portal\**" />
    <None Remove="portal\**" />
    <Content Remove="portal\**" />
  </ItemGroup>
</Project>
